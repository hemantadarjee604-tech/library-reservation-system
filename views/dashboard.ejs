<%- include('partials/header', {title}) %>
<div class="page-heading"><div><p class="eyebrow">OVERVIEW</p><h1>Hello, <%= currentUser.full_name %></h1><p class="muted">Your library activity at a glance.</p></div><a class="button" href="/books">Find a book</a></div>
<div class="stats-grid"><div class="stat-card"><span>Catalogue titles</span><strong><%= stats.books %></strong></div><div class="stat-card"><span>Active reservations</span><strong><%= stats.reservations %></strong></div><div class="stat-card"><span>Books on loan</span><strong><%= stats.loans %></strong></div><div class="stat-card"><span>Overdue loans</span><strong><%= stats.overdue %></strong></div></div>
<% if (isStaff) { %><div class="panel staff-panel"><h2>Library staff tools</h2><p>Manage the catalogue, check reservation requests, record collection and returns, and view reports.</p><div class="actions"><a class="button" href="/books/new">Add a book</a><a class="button button-secondary" href="/reservations">Manage reservations</a><a class="button button-secondary" href="/loans">Manage loans</a><a class="button button-secondary" href="/reports">View reports</a></div></div><% } %>
<div class="section-heading"><div><h2>Your active reservations</h2><p class="muted">A ready reservation includes a collection hold deadline.</p></div><a href="/reservations">All reservations →</a></div>
<div class="table-wrap"><table><thead><tr><th>Book</th><th>Status</th><th>Created</th><th>Collection deadline</th></tr></thead><tbody><% if (!mine.length) { %><tr><td colspan="4" class="empty-cell">You do not have any active reservations.</td></tr><% } %><% mine.forEach(r=>{ %><tr><td><strong><%= r.title %></strong><small><%= r.author %></small></td><td><span class="status status-<%= r.status %>"><%= r.status %></span></td><td><%= new Date(r.created_at).toLocaleDateString() %></td><td><%= r.expires_at ? new Date(r.expires_at).toLocaleString() : 'Waiting for a copy' %></td></tr><% }) %></tbody></table></div>
<%- include('partials/footer') %>
