<%- include('partials/header', {title}) %>
<div class="auth-wrap"><section class="panel auth-panel"><p class="eyebrow">JOIN THE LIBRARY</p><h1>Create account</h1><p class="muted">Student accounts can search and reserve books.</p><form method="post" action="/register" class="form-stack"><label>Full name<input name="full_name" minlength="2" maxlength="120" required></label><label>Email address<input type="email" name="email" required></label><label>Student ID <span class="muted">(optional)</span><input name="student_id" maxlength="40"></label><label>Password <span class="muted">(at least 8 characters)</span><input type="password" name="password" minlength="8" required></label><button class="button full" type="submit">Create account</button></form><p class="muted center">Already registered? <a href="/login">Log in</a></p></section></div>
<%- include('partials/footer') %>
