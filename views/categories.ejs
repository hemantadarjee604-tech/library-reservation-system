<%- include('partials/header', {title}) %>
<div class="page-heading"><div><p class="eyebrow">CATALOGUE SETUP</p><h1>Categories</h1><p class="muted">Organise titles so students can filter the catalogue.</p></div></div>
<div class="two-column"><section class="panel"><h2>Add category</h2><form method="post" action="/categories" class="form-stack"><label>Category name<input name="name" minlength="2" maxlength="100" required></label><label>Description<textarea name="description" rows="3"></textarea></label><button class="button">Save category</button></form></section><section class="panel"><h2>Existing categories</h2><div class="simple-list"><% categories.forEach(c=>{ %><div class="list-row"><div><strong><%= c.name %></strong><small><%= c.description || 'No description' %></small></div><span class="tag"><%= c.book_count %> titles</span></div><% }) %><% if(!categories.length){ %><p class="muted">No categories yet.</p><% } %></div></section></div>
<%- include('partials/footer') %>
