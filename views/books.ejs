<%- include('partials/header', {title}) %>
<div class="page-heading"><div><p class="eyebrow">CATALOGUE</p><h1>Find a book</h1><p class="muted">Search by title, author, or ISBN.</p></div><% if (currentUser && ['admin','librarian'].includes(currentUser.role)) { %><a class="button" href="/books/new">+ Add book</a><% } %></div>
<form class="search-bar" method="get" action="/books"><input name="q" value="<%= q %>" placeholder="Search titles, authors, ISBN…"><select name="category"><option value="">All categories</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= String(selectedCategory)===String(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select><button class="button" type="submit">Search</button><a class="button button-light" href="/books">Reset</a></form>
<div class="book-grid"><% if (!books.length) { %><div class="empty-state">No books match your search.</div><% } %><% books.forEach(book=>{ %><article class="book-card"><div class="book-cover">📘</div><div class="book-info"><span class="tag"><%= book.category || 'General' %></span><h3><a href="/books/<%= book.id %>"><%= book.title %></a></h3><p class="muted">by <%= book.author %></p><p class="muted"><%= book.isbn ? 'ISBN: '+book.isbn : 'ISBN not recorded' %></p><p class="availability"><%= book.available_copies %> available of <%= book.total_copies %> copies</p><a class="text-link" href="/books/<%= book.id %>">View details →</a></div></article><% }) %></div>
<%- include('partials/footer') %>
