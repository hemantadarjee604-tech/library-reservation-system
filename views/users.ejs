<%- include('partials/header', {title}) %>
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>User management</h1><p class="muted">New accounts are students. Only an administrator can change roles.</p></div></div>
<div class="table-wrap"><table><thead><tr><th>Name</th><th>Email / Student ID</th><th>Role</th><th>Joined</th><th>Update role</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><strong><%= u.full_name %></strong><small><%= u.is_active?'Active':'Disabled' %></small></td><td><%= u.email %><small><%= u.student_id || 'No student ID' %></small></td><td><span class="status"><%= u.role %></span></td><td><%= new Date(u.created_at).toLocaleDateString() %></td><td><form method="post" action="/users/<%= u.id %>/role" class="inline-form"><select name="role"><% ['student','librarian','admin'].forEach(role=>{ %><option value="<%= role %>" <%= u.role===role?'selected':'' %>><%= role %></option><% }) %></select><button class="button small-button">Save</button></form></td></tr><% }) %></tbody></table></div>
<%- include('partials/footer') %>
