<%- include('partials/header', {title}) %>
<div class="page-heading"><div><p class="eyebrow">CATALOGUE MANAGEMENT</p><h1>Add a book</h1><p class="muted">Each physical copy receives its own barcode.</p></div><a href="/books" class="button button-light">Back to catalogue</a></div>
<section class="panel"><form method="post" action="/books" class="form-grid"><label>Book title *<input name="title" maxlength="250" required></label><label>Author *<input name="author" maxlength="180" required></label><label>ISBN <input name="isbn" maxlength="20"></label><label>Publisher<input name="publisher" maxlength="180"></label><label>Publication year<input name="publication_year" type="number" min="1000" max="2200"></label><label>Category<select name="category_id"><option value="">Uncategorised</option><% categories.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label><label>Shelf / location<input name="shelf_location" maxlength="80" placeholder="e.g. Block A · Shelf 03"></label><label>Number of physical copies<input type="number" name="copy_count" min="1" max="500" value="1" required></label><label class="span-2">Description<textarea name="description" rows="4"></textarea></label><div class="span-2"><button class="button" type="submit">Save book</button></div></form></section>
<%- include('partials/footer') %>
