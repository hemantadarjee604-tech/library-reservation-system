<%- include('partials/header', {title}) %>
<div class="page-heading"><div><p class="eyebrow">CATALOGUE MANAGEMENT</p><h1>Edit book</h1><p class="muted">Update catalogue information. Existing copies and borrowing history are preserved.</p></div><a href="/books/<%= book.id %>" class="button button-light">Cancel</a></div>
<section class="panel"><form method="post" action="/books/<%= book.id %>/edit" class="form-grid"><label>Book title *<input name="title" maxlength="250" value="<%= book.title %>" required></label><label>Author *<input name="author" maxlength="180" value="<%= book.author %>" required></label><label>ISBN<input name="isbn" maxlength="20" value="<%= book.isbn || '' %>"></label><label>Publisher<input name="publisher" maxlength="180" value="<%= book.publisher || '' %>"></label><label>Publication year<input name="publication_year" type="number" min="1000" max="2200" value="<%= book.publication_year || '' %>"></label><label>Category<select name="category_id"><option value="">Uncategorised</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= String(book.category_id)===String(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select></label><label class="span-2">Shelf / location<input name="shelf_location" maxlength="80" value="<%= book.shelf_location || '' %>"></label><label class="span-2">Description<textarea name="description" rows="4"><%= book.description || '' %></textarea></label><div class="span-2"><button class="button" type="submit">Save changes</button></div></form></section>
<%- include('partials/footer') %>
