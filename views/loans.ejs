<%- include('partials/header', {title}) %>
<div class="page-heading"><div><p class="eyebrow">BORROWING</p><h1><%= isStaff ? 'Loans and returns' : 'My loans' %></h1><p class="muted"><%= isStaff ? 'Record physical returns after checking the copy in.' : 'Check due dates and your borrowing history.' %></p></div></div>
<div class="table-wrap"><table><thead><tr><th>Book / copy</th><% if(isStaff){ %><th>Borrower</th><% } %><th>Issued</th><th>Due date</th><th>Status</th><th>Action</th></tr></thead><tbody><% if(!loans.length){ %><tr><td colspan="6" class="empty-cell">No loans found.</td></tr><% } %><% loans.forEach(l=>{ %><tr><td><strong><%= l.title %></strong><small><%= l.author %> · <%= l.barcode %></small></td><% if(isStaff){ %><td><%= l.full_name %><small><%= l.email %></small></td><% } %><td><%= new Date(l.issued_at).toLocaleDateString() %></td><td><%= new Date(l.due_at).toLocaleDateString() %><% if(l.is_overdue){ %><small class="danger-text">Overdue</small><% } %></td><td><span class="status status-<%= l.status %>"><%= l.status %></span></td><td><% if(isStaff && l.status==='borrowed'){ %><form method="post" action="/loans/<%= l.id %>/return" onsubmit="return confirm('Confirm that this physical book has been returned?')"><button class="button small-button">Record return</button></form><% } else { %>—<% } %></td></tr><% }) %></tbody></table></div>
<%- include('partials/footer') %>
