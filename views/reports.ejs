<%- include('partials/header', {title}) %>
<div class="page-heading"><div><p class="eyebrow">LIBRARY ANALYTICS</p><h1>Reports</h1><p class="muted">Current inventory, low stock, issued books, waiting list and overdue loans.</p></div><button class="button button-secondary" onclick="window.print()">Print reports</button></div>
<section class="panel report-section"><h2>Current inventory</h2><div class="table-wrap"><table><thead><tr><th>Book</th><th>Total copies</th><th>Available</th><th>Issued</th></tr></thead><tbody><% inventory.forEach(r=>{ %><tr><td><%= r.title %><small><%= r.author %></small></td><td><%= r.total_copies %></td><td><%= r.available %></td><td><%= r.issued %></td></tr><% }) %></tbody></table></div></section>
<section class="panel report-section"><h2>Low stock <span class="tag">≤ 1 available</span></h2><div class="table-wrap"><table><thead><tr><th>Book</th><th>Author</th><th>Available copies</th></tr></thead><tbody><% lowStock.forEach(r=>{ %><tr><td><%= r.title %></td><td><%= r.author %></td><td><%= r.available %></td></tr><% }) %><% if(!lowStock.length){ %><tr><td colspan="3">No low-stock titles.</td></tr><% } %></tbody></table></div></section>
<section class="panel report-section"><h2>Currently issued</h2><div class="table-wrap"><table><thead><tr><th>Book</th><th>Borrower</th><th>Copy</th><th>Due</th></tr></thead><tbody><% issued.forEach(r=>{ %><tr><td><%= r.title %></td><td><%= r.full_name %></td><td><%= r.barcode %></td><td><%= new Date(r.due_at).toLocaleDateString() %></td></tr><% }) %><% if(!issued.length){ %><tr><td colspan="4">No books currently issued.</td></tr><% } %></tbody></table></div></section>
<section class="panel report-section"><h2>Overdue loans</h2><div class="table-wrap"><table><thead><tr><th>Book</th><th>Borrower</th><th>Copy</th><th>Due</th></tr></thead><tbody><% overdue.forEach(r=>{ %><tr><td><%= r.title %></td><td><%= r.full_name %><small><%= r.email %></small></td><td><%= r.barcode %></td><td class="danger-text"><%= new Date(r.due_at).toLocaleDateString() %></td></tr><% }) %><% if(!overdue.length){ %><tr><td colspan="4">No overdue loans.</td></tr><% } %></tbody></table></div></section>
<section class="panel report-section"><h2>Reservation waiting list</h2><div class="table-wrap"><table><thead><tr><th>Book</th><th>Student</th><th>Requested</th></tr></thead><tbody><% queue.forEach(r=>{ %><tr><td><%= r.title %></td><td><%= r.full_name %></td><td><%= new Date(r.created_at).toLocaleDateString() %></td></tr><% }) %><% if(!queue.length){ %><tr><td colspan="3">No students waiting for a copy.</td></tr><% } %></tbody></table></div></section>
<%- include('partials/footer') %>
