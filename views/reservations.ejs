<%- include('partials/header', {title}) %>
<div class="page-heading"><div><p class="eyebrow"><%= isStaff ? 'LIBRARY OPERATIONS' : 'YOUR ACCOUNT' %></p><h1>Reservations</h1><p class="muted"><%= isStaff ? 'Review reservations and confirm collection when a student arrives.' : 'Track the books you have reserved.' %></p></div></div>
<div class="table-wrap"><table><thead><tr><th>Book</th><% if(isStaff){ %><th>Student</th><% } %><th>Status</th><th>Copy / deadline</th><th>Requested</th><th>Action</th></tr></thead><tbody><% if(!reservations.length){ %><tr><td colspan="6" class="empty-cell">No reservations found.</td></tr><% } %><% reservations.forEach(r=>{ %><tr><td><strong><%= r.title %></strong><small><%= r.author %></small></td><% if(isStaff){ %><td><%= r.full_name %><small><%= r.email %></small></td><% } %><td><span class="status status-<%= r.status %>"><%= r.status %></span></td><td><%= r.barcode || 'Waiting for a copy' %><% if(r.expires_at && r.status==='ready'){ %><small>Hold until <%= new Date(r.expires_at).toLocaleString() %></small><% } %></td><td><%= new Date(r.created_at).toLocaleDateString() %></td><td class="actions-cell"><% if(isStaff && r.status==='ready'){ %><form method="post" action="/reservations/<%= r.id %>/collect"><button class="button small-button">Confirm collection</button></form><% } %><% if(['waiting','ready'].includes(r.status) && (isStaff || String(r.user_id)===String(currentUser.id))){ %><form method="post" action="/reservations/<%= r.id %>/cancel" onsubmit="return confirm('Cancel this reservation?')"><button class="button button-danger small-button">Cancel</button></form><% } %></td></tr><% }) %></tbody></table></div>
<%- include('partials/footer') %>
