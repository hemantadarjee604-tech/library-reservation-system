<%- include('partials/header', {title}) %>
<p><a class="text-link" href="/books">← Back to catalogue</a></p><section class="detail-layout"><div class="detail-cover">📚</div><div><span class="tag"><%= book.category || 'General' %></span><h1><%= book.title %></h1><h3 class="muted">by <%= book.author %></h3><p><%= book.description || 'No description has been added for this book.' %></p><div class="detail-list"><p><strong>ISBN:</strong> <%= book.isbn || 'Not recorded' %></p><p><strong>Publisher:</strong> <%= book.publisher || 'Not recorded' %></p><p><strong>Year:</strong> <%= book.publication_year || 'Not recorded' %></p><p><strong>Shelf:</strong> <%= book.shelf_location || 'Ask the librarian' %></p></div><% if (currentUser && ['admin','librarian'].includes(currentUser.role)) { %><p><a class="button button-secondary" href="/books/<%= book.id %>/edit">Edit book details</a></p><% } %><div class="copy-status"><% copies.forEach(c=>{ %><span><strong><%= c.count %></strong> <%= c.status %></span><% }) %></div><% if (currentUser) { %><form method="post" action="/books/<%= book.id %>/reserve"><button class="button" type="submit">Reserve this book</button></form><p class="muted small">If no copy is available, you will join the waiting list.</p><% } else { %><a class="button" href="/login">Log in to reserve</a><% } %></div></section>
<%- include('partials/footer') %>
